# Copy this file to .env and fill in your values.
# .env is ignored by git, so your token never gets committed.
# Never paste your token into chat, email, or screenshots.

# --- Deriv credentials ---------------------------------------------------
# Your API token (Trade scope only, never Admin or Payments).
DERIV_API_TOKEN=
# The App ID from the Deriv developer dashboard.
DERIV_APP_ID=

# --- Account ---------------------------------------------------------------
# demo (default) or real. Real also needs ALLOW_REAL_MONEY below.
DERIV_ACCOUNT_TYPE=demo
# Optional: pin a specific account ID (e.g. DOT90004580). Leave empty to use
# the first active account of DERIV_ACCOUNT_TYPE.
DERIV_ACCOUNT_ID=
# Must be exactly YES_I_UNDERSTAND before the bot will touch a real account.
ALLOW_REAL_MONEY=

# --- What to trade -----------------------------------------------------------
# watch = log prices only, never trades (default)
# demo_test = one tiny trade every few minutes to prove the plumbing (demo only)
STRATEGY=watch
SYMBOL=1HZ100V
MULTIPLIER=40
# Log trade decisions without buying anything.
DRY_RUN=false

# --- Hard risk limits (account currency) -----------------------------------
STAKE=1.00
MAX_STAKE=2.00
MAX_DAILY_LOSS=5.00
MAX_TRADES_PER_DAY=50
MAX_OPEN_TRADES=1
# After this many losses in a row, pause new trades for PAUSE_MINUTES.
MAX_CONSECUTIVE_LOSSES=3
PAUSE_MINUTES=30
# Close any trade still open after this many minutes (0 = no limit).
MAX_TRADE_MINUTES=10
# Optional per-trade exits sent to Deriv (empty = not set).
TAKE_PROFIT=
STOP_LOSS=

# --- Files -----------------------------------------------------------------
LOG_DIR=logs
STATE_DIR=state
# Create this file (any content) to stop the bot and close its open trades.
KILL_SWITCH_FILE=STOP
