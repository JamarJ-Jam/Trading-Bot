# Copy this file to .env and fill in your values.
# .env is ignored by git, so your token never gets committed.
# Never paste your token into chat, email, or screenshots.

# --- Deriv credentials ---------------------------------------------------
# Your API token (Trade scope only, never Admin or Payments).
DERIV_API_TOKEN=
# The App ID from the Deriv developer dashboard.
DERIV_APP_ID=

# --- Account ---------------------------------------------------------------
# demo (default) or real. Real also needs ALLOW_REAL_MONEY below.
DERIV_ACCOUNT_TYPE=demo
# Optional: pin a specific account ID (e.g. DOT90004580). Leave empty to use
# the first active account of DERIV_ACCOUNT_TYPE.
DERIV_ACCOUNT_ID=
# Must be exactly YES_I_UNDERSTAND before the bot will touch a real account.
ALLOW_REAL_MONEY=

# --- What to trade -----------------------------------------------------------
# watch = log prices only, never trades (default)
# demo_test = one tiny trade every few minutes to prove the plumbing (demo only)
# trend = trade moving-average crossovers on 1-minute candles
# mean_revert = bet on snap-backs after closes outside Bollinger bands
# breakout = trade the first break of the Asian range after London opens
STRATEGY=watch
# trend settings (EMA lengths in candles, candle size in seconds)
TREND_FAST=9
TREND_SLOW=21
TREND_CANDLE_SECONDS=60
# mean_revert = fade closes outside Bollinger bands
MR_PERIOD=20
MR_STD=2.0
MR_CANDLE_SECONDS=60
# breakout settings (UTC hours; candle size in seconds)
BO_CANDLE_SECONDS=900
BO_RANGE_START=0
BO_RANGE_END=7
BO_TRADE_END=12
SYMBOL=1HZ100V
MULTIPLIER=40
# Log trade decisions without buying anything.
DRY_RUN=false

# --- Hard risk limits (account currency) -----------------------------------
STAKE=1.00
MAX_STAKE=2.00
MAX_DAILY_LOSS=5.00
MAX_TRADES_PER_DAY=50
MAX_OPEN_TRADES=1
# After this many losses in a row, pause new trades for PAUSE_MINUTES.
MAX_CONSECUTIVE_LOSSES=3
PAUSE_MINUTES=30
# Close any trade still open after this many minutes (0 = no limit).
MAX_TRADE_MINUTES=10
# Close an open trade when the strategy signals the opposite direction, then
# take the new signal (classic trend following: hold until the trend turns).
# If Deriv closes the trade at expiry (7 days on crypto), or the bot restarts
# with nothing open, it opens a new trade in the trend's current direction.
EXIT_ON_REVERSE=false
# Optional per-trade exits sent to Deriv (empty = not set).
TAKE_PROFIT=
STOP_LOSS=

# --- Files -----------------------------------------------------------------
LOG_DIR=logs
STATE_DIR=state
# Create this file (any content) to stop the bot and close its open trades.
KILL_SWITCH_FILE=STOP

# --- Phone app (python -m server) --------------------------------------------
# Run `python -m server setup` (or, with Docker,
# `docker compose run --rm app python -m server setup`) and paste the three
# lines it prints here. Without them nobody can log in.
APP_PASSWORD_HASH=
APP_TOTP_SECRET=
APP_SECRET_KEY=
# Leave true when the app is reached over https (the Cloudflare Tunnel).
# Set false only to try the app at http://localhost.
APP_SECURE_COOKIE=true
# Markets the strategy lab and the AI can pick from.
LAB_SYMBOLS=frxEURUSD,frxGBPUSD,frxUSDJPY,frxAUDUSD

# --- AI strategy ideas (optional) ---------------------------------------------
# Make a separate OpenRouter key for this app and give it a credit limit.
OPENROUTER_API_KEY=
# Any OpenRouter model id; openrouter/auto lets OpenRouter choose.
OPENROUTER_MODEL=openrouter/auto
AI_MAX_IDEAS_PER_DAY=20

# --- Hosting -----------------------------------------------------------------------
# From Cloudflare Zero Trust > Networks > Tunnels (see docs/APP_GUIDE.md).
CLOUDFLARE_TUNNEL_TOKEN=
